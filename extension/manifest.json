{
  "manifest_version": 3,
  "name": "Orbita — чат поверх любого сайта",
  "version": "0.4.5",
  "description": "Прозрачный чат-оверлей поверх любой страницы: анонимные комнаты по языкам, голоса, звёзды «важное», топ за период, общая лента комментариев, раздел «Ответы» — сообщения, пришедшие именно вам, переход по ссылке прямо на сайт с оверлеем, зеркала сайтов в одном чате, ники и окна по каждому сайту, анимации перетаскиванием (огонь и щит с зарядами на сутки), звуковые оповещения и свой mp3, интерфейс на 8 языках.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Orbita: открыть чат этой страницы",
    "badge_color": "#16a34a",
    "badge_text": "",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+O" },
      "description": "Показать / скрыть оверлей Orbita"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["chat.html", "icons/icon48.png", "bg/*", "avatars/*", "icons/*.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
